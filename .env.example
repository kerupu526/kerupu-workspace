# 환경 변수 견본. 이 파일에는 실제 값을 쓰지 않는다 (저장소에 올라가는 파일이다).
#
# 쓰는 법
#   개발 컴퓨터:  이 파일을 .env.local 로 복사해서 값을 채운다 (npm run dev 가 읽는다)
#   운영 서버:    저장소 폴더에 .env 를 만들어 값을 채운다 (docker compose 가 읽는다)
#   .env, .env.local 은 .gitignore 와 .dockerignore 로 막혀 있어서 저장소와 이미지에 들어가지 않는다.
#   채운 값을 채팅이나 이슈, 커밋 메시지에 붙여 넣지 않는다.

# ---- Supabase ----
# 값은 Supabase 대시보드 > Project Settings 에서 복사한다.

# 프로젝트 주소. 브라우저로 나가도 되는 값이라 NEXT_PUBLIC_ 을 붙인다.
# (NEXT_PUBLIC_ 값은 빌드할 때 코드에 박힌다. 바꾸면 이미지를 다시 빌드해야 한다)
NEXT_PUBLIC_SUPABASE_URL=

# anon(공개) 키. 브라우저로 나가도 되지만, 그래서 모든 테이블에 RLS 를 켜 두어야 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키. RLS 를 건너뛰는 관리자 키라서 서버에서만 쓴다.
# 절대 NEXT_PUBLIC_ 을 붙이지 않고, 브라우저로 가는 코드(클라이언트 컴포넌트)에서 가져오지 않는다.
# 꼭 필요한 서버 작업이 생기기 전에는 비워 둔다. 글 저장은 사용자 세션으로 한다.
SUPABASE_SERVICE_ROLE_KEY=

# DB 비밀번호(Postgres 직접 접속용). 마이그레이션, 백업(pg_dump) 같은 관리 작업에만 쓴다.
# 앱 코드(웹 서버)는 이 값을 쓰지 않는다 — 앱은 위의 키로 API 를 통해 접속한다.
SUPABASE_DB_PASSWORD=
