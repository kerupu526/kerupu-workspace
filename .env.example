# 환경 변수 견본. 이 파일에는 실제 값을 쓰지 않는다 (저장소에 올라가는 파일이다).
#
# 쓰는 법
#   개발 컴퓨터:  이 파일을 .env.local 로 복사해서 값을 채운다 (npm run dev 가 읽는다)
#   운영 서버:    저장소 폴더에 .env 를 만들어 값을 채운다 (docker compose 가 읽는다)
#   .env, .env.local 은 .gitignore 와 .dockerignore 로 막혀 있어서 저장소와 이미지에 들어가지 않는다.
#   채운 값을 채팅이나 이슈, 커밋 메시지에 붙여 넣지 않는다.

# ---- 서버 배치 (docker-compose.yml 이 읽는다. 비밀은 아니지만 서버마다 다르다) ----
# 컨테이너를 어느 주소의 어느 포트로 열지. 둘 다 비우면 127.0.0.1:3000 (이 컴퓨터 안에서만).
# 예) 다른 서비스가 3000번을 쓰는 서버에서 Tailscale 안으로만 열 때:
#   BIND_ADDRESS=100.x.y.z
#   HOST_PORT=3100
BIND_ADDRESS=
HOST_PORT=

# 이 사이트의 공개 주소. 확인 메일 링크가 여기로 돌아온다. 접속용 주소(0.0.0.0 등)를 쓰지 않는다.
# 운영 서버: https://kerupu.tech   /  개발 컴퓨터(.env.local): http://localhost:3000
SITE_URL=

# ---- Supabase ----
# 값은 Supabase 대시보드 > Project Settings 에서 복사한다.

# 프로젝트 주소. 브라우저로 나가도 되는 값이라 NEXT_PUBLIC_ 을 붙인다.
# (NEXT_PUBLIC_ 값은 빌드할 때 코드에 박힌다. 바꾸면 이미지를 다시 빌드해야 한다)
NEXT_PUBLIC_SUPABASE_URL=

# publishable(공개) 키 (sb_publishable_...). 브라우저로 나가도 되지만, 그래서 모든 테이블에 RLS 를 켜 두어야 한다.
# (예전 이름은 anon 키. Supabase 가 Legacy 로 분류한 anon, service_role 키 대신 새 Publishable, Secret 키를 쓴다)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret 키 (sb_secret_...). RLS 를 건너뛰는 관리자 키라서 서버에서만 쓴다. (예전 이름은 service_role 키)
# 절대 NEXT_PUBLIC_ 을 붙이지 않고, 브라우저로 가는 코드(클라이언트 컴포넌트)에서 가져오지 않는다.
# 꼭 필요한 서버 작업이 생기기 전에는 비워 둔다. 글 저장은 사용자 세션으로 한다.
SUPABASE_SECRET_KEY=

# DB 비밀번호(SUPABASE_DB_PASSWORD)는 이 파일에 넣지 않는다.
# 마이그레이션, 백업(pg_dump) 같은 관리 작업에만 쓰이고 웹 앱은 쓰지 않는데, 이 파일은 컨테이너 환경에
# 통째로 들어가기 때문이다. 서버의 ~/.config/kerupu/admin.env (권한 600) 에 따로 둔다. docs/deploy.md 참고.
